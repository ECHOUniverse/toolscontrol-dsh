{
  "name": "@hanxu131/toolscontrol-dsh",
  "version": "0.1.0",
  "description": "DSH 内只读总览 MCP 与 Skills 状态和来源的独立插件（宿主半：聚合快照与显式探测路由）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.en.md", "docs"],
  "license": "Apache-2.0",
  "author": "hanxu131",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "mcp", "skills", "overview"],
  "engines": { "node": "^22.19.0 || >=24", "dsh": ">=0.2.1-rc.1 <0.3.0-0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf lib",
    "verify": "npm run clean && npm run build && npm run typecheck && npm run test && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
